    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
